# Field Shift backend configuration
# Copy to backend/.env and adjust. NEVER commit the real .env.

# live  -> call external providers for real (with graceful degradation)
# cached -> serve only cached responses if present, otherwise fail honestly
# demo_fixture -> use clearly-labelled demo fixtures only (for offline judging)
DATA_MODE=live

# Feature toggles (all optional providers degrade honestly when disabled/unavailable)
POWER_ENABLED=true
SOILGRIDS_ENABLED=true
GAEZ_ENABLED=false
SEARCH_ENABLED=true

# NASA POWER
POWER_COMMUNITY=AG
POWER_TIMEOUT_SECONDS=25
POWER_MAX_RETRIES=2

# Cache lifetime for provider responses (seconds)
PROVIDER_CACHE_TTL_SECONDS=86400

# Database (SQLite file path, relative to backend/)
DATABASE_URL=sqlite:///./fieldshift.db

# CORS origins for the Vite dev server (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Analysis limits
MIN_FIELD_AREA_HA=0.01
MAX_FIELD_AREA_HA=50000
ROTATION_HORIZON_YEARS=3
